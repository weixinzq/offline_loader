<Window x:Class="AolaLoader.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账号" Width="440" Height="545"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Border Style="{StaticResource CardStyle}" Margin="20">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock x:Name="Heading" Text="新增账号" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,22" />

      <StackPanel Grid.Row="1" Margin="0,0,0,15">
        <TextBlock Text="账号标签" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,6" />
        <TextBox x:Name="LabelBox" />
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,0,0,15">
        <TextBlock Text="登录账号" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,6" />
        <TextBox x:Name="AccountBox" />
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="0,0,0,15">
        <TextBlock x:Name="PasswordLabel" Text="密码" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,6" />
        <PasswordBox x:Name="PasswordInput" />
      </StackPanel>
      <StackPanel Grid.Row="4" Margin="0,0,0,15">
        <TextBlock Text="角色编号（charId）" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,6" />
        <TextBox x:Name="CharIdBox" Text="0" />
      </StackPanel>
      <StackPanel Grid.Row="5">
        <TextBlock Text="区服编号" Foreground="{StaticResource SecondaryTextBrush}" Margin="2,0,0,6" />
        <TextBox x:Name="ZoneBox" Text="1025" />
      </StackPanel>

      <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Click="Cancel_Click" />
        <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
