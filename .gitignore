# 默认只发布下方列出的源码、依赖和构建输入；本地任务及运行数据不纳入 Git。
*
!*/

# 项目入口、依赖和说明
!/.gitignore
!/README.md
!/pyproject.toml
!/requirements.txt
!/requirements.lock
!/requirements-build.txt
!/cli_main.py
!/backend_main.py

# Python 实现和随程序提供的专用脚本
!/src/**/*.py
!/scripts/*.py
/scripts/test_*.py
/scripts/verify.py
/scripts/_fake_mihomo.py

# 网页源码及构建依赖
!/frontend/index.html
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/tsconfig.json
!/frontend/vite.config.ts
!/frontend/src/**/*.vue
!/frontend/src/**/*.ts
!/frontend/src/**/*.css
/frontend/src/**/*.test.ts

# 旧版 Windows 桌面源码及打包输入
!/csharp/AolaLoader/**/*.cs
!/csharp/AolaLoader/**/*.xaml
!/csharp/AolaLoader/*.csproj
!/build_wpf.ps1
!/aola_backend.spec
!/config.example.json

# 通用接口导出和探测工具；具体任务 JSON 不发布
!/tools/export_openapi.py
!/tools/run_server_probe.py

# 排除缓存、依赖、构建产物与本地文件（优先于上方源码规则）
.git/
__pycache__/
node_modules/
bin/
obj/
/.venv/
/build/
/dist/
/frontend/dist/
/frontend/coverage/
/data/
/logs/
/evidence/
/.git-backups/
/analysis/
/tte/
/Script/
/Com/
/.agents/
/.codex/
